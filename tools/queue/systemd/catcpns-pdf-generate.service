[Unit]
Description=CAT CPNS Queue Worker (pdf-generate)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/cat-cpns
ExecStart=/usr/bin/php artisan queue:work database --queue=pdf-generate --sleep=2 --tries=1 --timeout=900

[Install]
WantedBy=multi-user.target
